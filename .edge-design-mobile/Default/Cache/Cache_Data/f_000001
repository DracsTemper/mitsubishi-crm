document.addEventListener('DOMContentLoaded',()=>{
 const sidebar=document.querySelector('.sidebar');
 document.querySelector('[data-sidebar-toggle]')?.addEventListener('click',()=>sidebar?.classList.toggle('open'));
 document.querySelectorAll('[data-filter]').forEach(el=>el.addEventListener('input',()=>{const q=el.value.toLowerCase();document.querySelectorAll('[data-search-row]').forEach(row=>row.hidden=!row.textContent.toLowerCase().includes(q))}));
 document.querySelectorAll('[data-demo-action]').forEach(btn=>btn.addEventListener('click',()=>{const toast=document.querySelector('.toast-demo');if(toast){toast.textContent=btn.dataset.message||'Action completed successfully';toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2600)}}));
 document.querySelectorAll('.slot:not(.busy)').forEach(slot=>slot.addEventListener('click',()=>{slot.classList.add('is-selected');setTimeout(()=>slot.classList.remove('is-selected'),260);const input=document.querySelector('#bookingTime');if(input)input.value=slot.dataset.time||'';bootstrap.Modal.getOrCreateInstance(document.querySelector('#bookingModal')).show()}));
 document.querySelectorAll('[data-chat-contact]').forEach(c=>c.addEventListener('click',()=>{document.querySelectorAll('[data-chat-contact]').forEach(x=>x.classList.remove('active'));c.classList.add('active');document.querySelector('#chatName').textContent=c.dataset.name}));
 document.querySelector('#sendMessage')?.addEventListener('click',()=>{const input=document.querySelector('#messageInput');if(!input.value.trim())return;const m=document.createElement('div');m.className='message out';m.innerHTML=`${input.value.replace(/[<>]/g,'')}<small>Just now</small>`;document.querySelector('.messages').appendChild(m);input.value='';m.scrollIntoView({behavior:'smooth'})});
 const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
 document.querySelectorAll('[data-count]').forEach((el,i)=>{if(reduced)return;const raw=el.dataset.count,goal=parseFloat(raw),prefix=el.dataset.prefix||'',suffix=el.dataset.suffix||'',decimals=(raw.split('.')[1]||'').length,start=performance.now();el.textContent=prefix+'0'+suffix;const tick=now=>{const p=Math.min((now-start)/520,1),ease=1-Math.pow(1-p,3);el.textContent=prefix+(goal*ease).toFixed(decimals)+suffix;if(p<1)requestAnimationFrame(tick)};setTimeout(()=>requestAnimationFrame(tick),i*45)});
 const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target)}}),{threshold:.1});document.querySelectorAll('.reveal,.activity').forEach((el,i)=>{el.style.setProperty('--delay',`${(i%6)*55}ms`);observer.observe(el)});
 const tip=document.querySelector('.chart-tip');document.querySelectorAll('.bar-wrap').forEach((bar,i)=>{bar.addEventListener('mouseenter',e=>{if(!tip)return;tip.innerHTML=`<strong>${bar.textContent.trim()}</strong><br>Cars Sold: ${Math.round(parseFloat(bar.querySelector('.bar')?.style.height||0)/14)}<br>Revenue: ৳${(1.2+i*.08).toFixed(1)}M`;tip.classList.add('show')});bar.addEventListener('mousemove',e=>{tip.style.left=`${e.clientX+14}px`;tip.style.top=`${e.clientY-58}px`});bar.addEventListener('mouseleave',()=>tip?.classList.remove('show'))});
 document.querySelectorAll('[data-message="Test drive booking confirmed"]').forEach(btn=>{btn.removeAttribute('data-bs-dismiss');btn.setAttribute('data-confirm-booking','')});
 document.querySelectorAll('[data-confirm-booking]').forEach(btn=>btn.addEventListener('click',()=>{const modal=btn.closest('.modal-content');modal.innerHTML='<div class="booking-success"><div class="success-check">✓</div><h3>Booking confirmed</h3><p class="fs-5 fw-bold">BK-00124</p><p class="text-secondary">Vehicle reserved for Rahim Ahmed.</p><button class="btn btn-primary" data-bs-dismiss="modal">Done</button></div>'}));
 document.querySelectorAll('.slot.busy').forEach(slot=>slot.addEventListener('click',()=>{const toast=document.querySelector('.toast-demo');if(toast){toast.textContent='Booked slot · Test drive details are unavailable for editing';toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2600)}}));
});
