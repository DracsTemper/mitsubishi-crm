qa('[data-cx-filter]').forEach(b=>b.addEventListener('click',()=>{qa('[data-cx-filter]').forEach(x=>x.classList.remove('active'));b.classList.add('active');toast(`${b.textContent.trim()} vehicles selected`)}));qa('[data-gallery-thumb]').forEach(b=>b.addEventListener('click',()=>{q('[data-gallery-main]').src=b.dataset.galleryThumb;qa('[data-gallery-thumb]').forEach(x=>x.classList.remove('active'));b.classList.add('active')}));qa('[data-slot]').forEach(b=>b.addEventListener('click',()=>{if(b.classList.contains('busy'))return;qa('[data-slot]').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');q('[data-selected-time]')&&(q('[data-selected-time]').textContent=b.dataset.slot)}));qa('[data-demo]').forEach(b=>b.addEventListener('click',()=>toast(b.dataset.demo||'Saved to your Mitsubishi journey')));
q('[data-send-message]')?.addEventListener('click',()=>{const input=q('[data-message-input]');if(!input.value.trim())return;const m=document.createElement('div');m.className='cx-bubble mine';m.innerHTML=`${input.value.replace(/[<>]/g,'')}<small>Just now</small>`;q('[data-messages]').appendChild(m);input.value='';m.scrollIntoView({behavior:'smooth'})});qa('[data-suggested-question]').forEach(b=>b.addEventListener('click',()=>{q('[data-message-input]').value=b.textContent.trim();q('[data-message-input]').focus()}));
});
</script></body></html>
